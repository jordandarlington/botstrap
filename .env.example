# Copy this file to .env for local development.

NODE_ENV=development
LOG_LEVEL=debug
PORT=3000

# GitHub App settings
APP_ID=YOUR_GITHUB_APP_ID
WEBHOOK_SECRET=replace-with-a-random-secret
PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nreplace-this-with-your-private-key\n-----END RSA PRIVATE KEY-----"

# smee.io channel URL used both here and in the GitHub App webhook settings
WEBHOOK_PROXY_URL=https://smee.io/YOUR_CHANNEL_ID
