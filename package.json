{
  "name": "botstrap",
  "version": "1.0.0",
  "description": "A Modular GitHub Bot Platform",
  "main": "app.js",
  "bin": {
    "botstrap": "./bin/botstrap.js"
  },
  "directories": {
    "lib": "lib"
  },
  "scripts": {
    "test": "jest",
    "dev": "probot run ./app.js",
    "webhook-proxy": "npx smee-client --url \"$WEBHOOK_PROXY_URL\" --path /api/github/webhooks --port \"$PORT\""
  },
  "jest": {
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ]
  },
  "keywords": [],
  "author": "Bots Gone Wild",
  "license": "ISC",
  "dependencies": {
    "@oclif/core": "^4.2.10",
    "boxen": "^5.1.2",
    "chalk": "^4.1.2",
    "cli-table3": "^0.6.5",
    "js-yaml": "^4.1.1",
    "probot": "^14.3.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.14",
    "smee-client": "^5.0.0"
  }
}
